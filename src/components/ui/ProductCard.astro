---
import { Image } from 'astro:assets';
import type { Product } from '../../utils/products';
import { productUrl, brandName } from '../../utils/products';
import { formatCOP } from '../../data/site';
import { CATEGORY_NAMES } from '../../data/brands';
import { productImage } from '../../utils/images';

interface Props { product: Product; eager?: boolean; showBrand?: boolean }
const { product, eager = false, showBrand = true } = Astro.props;
const { data } = product;
const img = productImage(data.image);
const url = productUrl(product);
const badge: Record<string, string> = {
  nutrilite: 'bg-nutrilite', artistry: 'bg-artistry', satinique: 'bg-satinique',
  'g-h': 'bg-gh', 'amway-home': 'bg-home', glister: 'bg-glister', amway: 'bg-primary',
};
---

<article class="card group relative flex h-full flex-col overflow-hidden">
  <div class="relative aspect-square overflow-hidden bg-surface">
    {img ? (
      <Image
        src={img}
        alt={data.name}
        width={480}
        height={480}
        format="webp"
        quality={78}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      />
    ) : (
      <img src={data.image} alt={data.name} loading="lazy" width="480" height="480" class="h-full w-full object-cover" />
    )}
    {showBrand && (
      <span class:list={['absolute left-3 top-3 rounded-full px-2.5 py-1 text-[11px] font-semibold text-white', badge[data.brand]]}>
        {brandName(data.brand)}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-4">
    <p class="eyebrow">{CATEGORY_NAMES[data.category] ?? data.category}</p>
    <h3 class="mt-1 text-base font-bold leading-snug">
      <a href={url} class="after:absolute after:inset-0 focus:outline-none">{data.name}</a>
    </h3>
    <div class="mt-auto flex items-end justify-between pt-4">
      <div>
        <p class="text-[11px] text-muted">Precio de lista</p>
        <p class="font-display text-lg font-extrabold text-ink">{formatCOP(data.price)}</p>
      </div>
      <span class="inline-flex h-9 items-center rounded-lg bg-primary-50 px-3 text-xs font-semibold text-primary transition-colors group-hover:bg-primary group-hover:text-white">Ver</span>
    </div>
  </div>
</article>
