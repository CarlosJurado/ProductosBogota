---
const {
  servicio,
  servicio1,
  servicio2,
  servicio3,
  cliente1,
  cliente2,
  cliente3,
} = Astro.props;
---

<section class="bg-gray-100">
  <div
    class="mx-auto w-full lg:px-24 max-w-7xl md:px-12 items-center px-8 py-24"
  >
    <div class="max-w-2xl mx-auto md:text-center">
      <h2 class="text-black font-extrabold lg:text-5xl text-4xl tracking-tight">
        Nuestros Clientes
      </h2>
    </div>
    <ul
      role="list"
      class="grid max-w-2xl grid-cols-1 gap-6 mx-auto mt-16 sm:gap-8 lg:mt-20 lg:max-w-none lg:grid-cols-3"
    >
      <li>
        <ul role="list" class="flex flex-col gap-y-6 sm:gap-y-8">
          <li>
            <figure class="relative h-full p-6 bg-white rounded-3xl">
              <blockquote class="relative">
                <p class="text-base text-gray-500">
                  {servicio1}
                </p>
              </blockquote>
              <figcaption
                class="relative flex items-center justify-between pt-6 mt-6 border-t border-gray-100"
              >
                <div>
                  <div
                    class="text-lg font-semibold leading-6 text-black font-display"
                  >
                    {cliente1}
                  </div>
                </div>
                <div class="overflow-hidden rounded-full bg-gray-50">
                  <img
                    alt={servicio}
                    src="/images/Darwin-Ramirez.png"
                    width="56"
                    height="56"
                    decoding="async"
                    data-nimg="future"
                    class="object-cover h-14 w-14"
                    loading="lazy"
                    style="color: transparent"
                  />
                </div>
              </figcaption>
            </figure>
          </li>
        </ul>
      </li>
      <li>
        <ul role="list" class="flex flex-col gap-y-6 sm:gap-y-8">
          <li>
            <figure class="relative h-full p-6 bg-white rounded-3xl">
              <blockquote class="relative">
                <p class="text-base text-gray-500">
                  {servicio2}
                </p>
              </blockquote>
              <figcaption
                class="relative flex items-center justify-between pt-6 mt-6 border-t border-gray-100"
              >
                <div>
                  <div
                    class="text-lg font-semibold leading-6 text-black font-display"
                  >
                    {cliente2}
                  </div>
                </div>
                <div class="overflow-hidden rounded-full bg-gray-50">
                  <img
                    alt={servicio}
                    src="/images/Francisco-Martinez.png"
                    width="56"
                    height="56"
                    decoding="async"
                    data-nimg="future"
                    class="object-cover h-14 w-14"
                    loading="lazy"
                    style="color: transparent"
                  />
                </div>
              </figcaption>
            </figure>
          </li>
        </ul>
      </li>
      <li>
        <ul role="list" class="flex flex-col gap-y-6 sm:gap-y-8">
          <li>
            <figure class="relative h-full p-6 bg-white rounded-3xl">
              <blockquote class="relative">
                <p class="text-base text-gray-500">
                  {servicio3}
                </p>
              </blockquote>
              <figcaption
                class="relative flex items-center justify-between pt-6 mt-6 border-t border-gray-100"
              >
                <div>
                  <div
                    class="text-lg font-semibold leading-6 text-black font-display"
                  >
                    {cliente3}
                  </div>
                </div>
                <div class="overflow-hidden rounded-full bg-gray-50">
                  <img
                    alt={servicio}
                    src="/images/Andrea-Casallas.png"
                    width="56"
                    height="56"
                    decoding="async"
                    data-nimg="future"
                    class="object-cover h-14 w-14"
                    loading="lazy"
                    style="color: transparent"
                  />
                </div>
              </figcaption>
            </figure>
          </li>
        </ul>
      </li>
    </ul>
  </div>
</section>
