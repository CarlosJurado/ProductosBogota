---
const items = [
  { t: 'Producto 100% original', d: 'Inventario oficial Amway Colombia, sellado y con registro INVIMA.' },
  { t: 'Garantía de satisfacción', d: 'Amway respalda todos sus productos con su garantía de satisfacción.' },
  { t: 'Entrega a domicilio', d: 'Bogotá en 1–2 días hábiles. Envíos a toda Colombia.' },
  { t: 'Asesoría personalizada', d: 'Te ayudamos a elegir el producto correcto antes de comprar.' },
];
---

<section class="border-y border-line bg-surface" aria-label="Garantías">
  <div class="container-x grid grid-cols-2 gap-6 py-8 lg:grid-cols-4">
    {items.map((it) => (
      <div class="flex gap-3">
        <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cta-50 text-cta">
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold">{it.t}</p>
          <p class="mt-0.5 text-xs text-muted">{it.d}</p>
        </div>
      </div>
    ))}
  </div>
</section>
