---
import { SITE, waLink } from '../../data/site';
interface Props { productName?: string }
const { productName } = Astro.props;
const msg = productName ? `Hola, quiero pedir ${productName}. ¿Está disponible?` : 'Hola, quiero hacer un pedido de productos Amway en Bogotá.';
const steps = [
  { n: '01', t: 'Elige tu producto', d: 'Revisa la ficha, el precio de lista en pesos y los beneficios. Si tienes dudas, te asesoramos sin compromiso.' },
  { n: '02', t: 'Pide por WhatsApp', d: `Escríbenos al ${SITE.phoneDisplay} con el nombre del producto. Confirmamos disponibilidad y total en minutos.` },
  { n: '03', t: 'Recibe en casa', d: 'Entrega a domicilio en Bogotá en 1 a 2 días hábiles. Envíos a toda Colombia por transportadora.' },
];
---

<section id="como-comprar" class="bg-primary text-white">
  <div class="container-x grid gap-10 py-16 lg:grid-cols-[1.1fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow text-white/60">Cómo comprar</p>
      <h2 class="mt-2 text-3xl font-extrabold text-white sm:text-4xl">Productos Amway originales, sin registro obligatorio</h2>
      <p class="mt-4 max-w-xl text-white/80">
        Somos Empresarios Independientes Amway en Bogotá. Compras directo, pagas contra entrega o por transferencia, y si quieres descuentos permanentes te ayudamos a registrarte como Cliente Amway.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={waLink(msg)} target="_blank" rel="noopener" class="btn-cta h-12 px-6">Pedir por WhatsApp</a>
        <a href={SITE.registerClient} target="_blank" rel="noopener nofollow" class="btn h-12 border border-white/30 px-6 text-white hover:bg-white/10">Registrarme como Cliente Amway</a>
      </div>
    </div>
    <ol class="grid gap-4">
      {steps.map((s) => (
        <li class="flex gap-4 rounded-2xl bg-white/5 p-5 ring-1 ring-white/10">
          <span class="font-display text-2xl font-extrabold text-gold">{s.n}</span>
          <div>
            <h3 class="font-bold text-white">{s.t}</h3>
            <p class="mt-1 text-sm text-white/75">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
