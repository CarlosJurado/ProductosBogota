---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Preguntas frecuentes' } = Astro.props;
---

<section class="container-x py-16" aria-labelledby="faq-title">
  <div class="mx-auto max-w-3xl">
    <h2 id="faq-title" class="text-3xl font-extrabold">{title}</h2>
    <div class="mt-8 divide-y divide-line rounded-2xl border border-line">
      {items.map((f, i) => (
        <details class="group p-5" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            <span>{f.q}</span>
            <svg class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
          </summary>
          <p class="mt-3 text-ink-soft leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
