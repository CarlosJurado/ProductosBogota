---
import { BRANDS } from '../../data/brands';
import { SITE, waLink } from '../../data/site';

const nav = Object.values(BRANDS).filter((b) => b.slug !== 'glister');
const current = Astro.url.pathname;
const wa = waLink('Hola, quiero información sobre productos Amway en Bogotá.');
---

<header class="sticky top-0 z-50 border-b border-line bg-white/90 backdrop-blur supports-[backdrop-filter]:bg-white/75">
  <div class="bg-primary text-white text-xs">
    <div class="container-x flex h-9 items-center justify-between gap-4">
      <p class="truncate">Empresario Independiente Amway · Entrega a domicilio en Bogotá · Envíos a toda Colombia</p>
      <a href={`tel:${SITE.phoneE164}`} class="shrink-0 font-semibold hover:underline">{SITE.phoneDisplay}</a>
    </div>
  </div>

  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label="Productos Bogotá, inicio">
      <img src="/images/favicons/android-chrome-192x192.png" alt="" width="36" height="36" class="h-9 w-9 rounded-lg" />
      <span class="font-display text-lg font-extrabold leading-none text-ink">
        Productos<span class="text-primary">Bogotá</span>
      </span>
    </a>

    <nav aria-label="Marcas" class="hidden lg:flex items-center gap-1">
      {nav.map((b) => {
        const active = current.startsWith(`/${b.slug}/`);
        return (
          <a
            href={`/${b.slug}/`}
            class:list={[
              'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
              active ? 'bg-surface text-ink' : 'text-ink-soft hover:bg-surface hover:text-ink',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {b.name}
          </a>
        );
      })}
      <a href="/#catalogo" class="rounded-lg px-3 py-2 text-sm font-medium text-ink-soft hover:bg-surface hover:text-ink">Catálogo</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href={wa} class="btn-cta hidden sm:inline-flex h-10 px-4" rel="noopener" target="_blank">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4 5.2 5.2 0 0 0 3.2.7 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg>
        Pedir por WhatsApp
      </a>
      <button
        type="button"
        class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="menu-movil" hidden class="lg:hidden border-t border-line bg-white">
    <nav aria-label="Marcas (móvil)" class="container-x grid grid-cols-2 gap-2 py-4">
      {nav.map((b) => (
        <a href={`/${b.slug}/`} class="rounded-xl border border-line px-4 py-3 text-sm font-medium hover:bg-surface">
          {b.name}
          <span class="block text-xs font-normal text-muted">{b.short}</span>
        </a>
      ))}
      <a href="/#catalogo" class="col-span-2 rounded-xl bg-surface px-4 py-3 text-center text-sm font-semibold">Ver catálogo completo</a>
      <a href={wa} class="col-span-2 btn-cta" rel="noopener" target="_blank">Pedir por WhatsApp</a>
    </nav>
  </div>
</header>

<script>
  function initMenu() {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.getElementById('menu-movil');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    });
  }
  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
