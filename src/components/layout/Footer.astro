---
import { BRANDS } from '../../data/brands';
import { SITE } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="container-x grid gap-10 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="font-display text-xl font-extrabold">Productos<span class="text-primary">Bogotá</span></p>
      <p class="mt-3 max-w-md text-sm text-ink-soft">
        Catálogo de productos Amway con precios de lista en Colombia, atendido por un Empresario Independiente Amway en Bogotá.
        Pedidos por WhatsApp, entrega a domicilio en Bogotá y envíos nacionales.
      </p>
      <address class="mt-5 not-italic text-sm text-ink-soft">
        <p>{SITE.address.street}, {SITE.address.city}</p>
        <p><a href={`tel:${SITE.phoneE164}`} class="font-semibold text-ink hover:underline">Cel: {SITE.phoneDisplay}</a></p>
        <p class="mt-1 text-muted">Lunes a sábado, 8:00 a. m. – 6:00 p. m.</p>
      </address>
    </div>

    <nav aria-label="Marcas (pie)">
      <h2 class="text-sm font-semibold">Marcas Amway</h2>
      <ul class="mt-4 space-y-2 text-sm text-ink-soft">
        {Object.values(BRANDS).map((b) => (
          <li><a href={`/${b.slug}/`} class="hover:text-ink">{b.name} · {b.short}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Enlaces">
      <h2 class="text-sm font-semibold">Comprar</h2>
      <ul class="mt-4 space-y-2 text-sm text-ink-soft">
        <li><a href="/#catalogo" class="hover:text-ink">Catálogo completo</a></li>
        <li><a href="/#como-comprar" class="hover:text-ink">Cómo comprar</a></li>
        <li><a href={SITE.registerClient} rel="noopener nofollow" target="_blank" class="hover:text-ink">Registrarme como Cliente Amway</a></li>
        <li><a href={SITE.registerBusiness} rel="noopener nofollow" target="_blank" class="hover:text-ink">Iniciar mi negocio Amway</a></li>
        <li><a href={SITE.social.facebook} rel="noopener nofollow" target="_blank" class="hover:text-ink">Facebook</a></li>
        <li><a href="/politica-privacidad/" class="hover:text-ink">Política de privacidad</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.legalName}. Sitio de un Empresario Independiente Amway; no es el sitio oficial de Amway Colombia.</p>
      <p>Amway, Nutrilite, Artistry, Satinique, G&amp;H, Glister y Amway Home son marcas registradas de Alticor Inc.</p>
    </div>
  </div>
</footer>
