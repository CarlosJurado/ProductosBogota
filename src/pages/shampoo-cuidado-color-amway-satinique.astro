---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/shampoo-cuidado-color-amway-satinique.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Shampoo Cuidado Color Satinique - Cel: 322 346 1713",
  brand: "Shampoo Cuidado Color Satinique - Productos Amway Bogota",
  servicio: "Shampoo Cuidado Color Satinique",
  description: "🌈 Shampoo Cuidado Color Satinique: Cuida y revitaliza tu color de cabello, manteniendo su brillo y protección con una fórmula que prolonga la belleza de tu color. Ideal para un cabello más sano y luminoso. 🌟 ¡Oferta especial por tiempo limitado! Pide el tuyo hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/shampoo-cuidado-color-amway-satinique/",
  image: "https://productosbogota.com/shampoo-cuidado-color-amway-satinique.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "52850",
  reviews: "87154",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"🌈 Shampoo Cuidado Color Satinique. Este sistema de shampoo y acondicionador ofrece una limpieza delicada y un acondicionamiento suave para proteger, fortalecer y reparar el cabello, mientras ayuda a mantener el color e intensificar el brillo. El cabello se siente suave y sedoso.",
  caracteristica1:"El cabello maltratado se revitaliza y el color se mantiene por más tiempo, ya que este shampoo fue diseñado para el cabello dañado o teñido. Contiene compuestos botánicos como extracto de granada y extracto de semilla de uva."  ,
  caracteristica2:"Fórmula libre de sulfatos, lo cual ayuda a proteger el color contra el desvanecimiento. Ayuda a fortalecer el cabello hasta 9 veces. Reduce la decoloración, ayudando a mantener el color hasta 45 lavadas.",
  caracteristica3:"Cuenta con el exclusivo Complejo Enerjuve que ayuda a restaurar el estado natural del cabello y su apariencia saludable. Mantiene el color original por más tiempo. Ayuda a reparar el cabello y a prevenir las puntas abiertas."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
