---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/loc-limpiador-concentrado-multiusos-amway-home.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "L.O.C. Limpiador Concentrado Multiusos - Cel: 322 346 1713",
  brand: "L.O.C. Limpiador Concentrado Multiusos - Productos Amway Bogota",
  servicio: "L.O.C. Limpiador Concentrado Multiusos",
  description: "🧼 L.O.C. Limpiador Concentrado Multiusos: Limpia y desinfecta eficazmente tu hogar con este producto versátil y amigable con el medio ambiente. Ideal para un hogar limpio y saludable. 🌟 ¡Oferta especial por tiempo limitado! Compra hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/loc-limpiador-concentrado-multiusos-amway-home/",
  image: "https://productosbogota.com/loc-limpiador-concentrado-multiusos-amway-home.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "61050",
  reviews: "69",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "🧼 L.O.C. Limpiador Concentrado Multiusos. Apto para cualquier artículo y superficie lavable. El L.O.C. Limpiador Concentrado Multiusos con ingredientes derivados de fuentes naturales sin blanqueador, es de alto desempeño y versátil, por eso es la elección correcta, siempre.",
  caracteristica1: "1 l de L.O.C. Limpiador Concentrado Multiusos rinde 10 litros de otras marcas.",
  caracteristica2: "Fórmula concentrada que rinde hasta 18 botellas de 500 ml diluido (1:8). Funciona en todos los objetos y superficies lavables con agua.",
  caracteristica3: "Quita manchas difíciles. No se necesita enjuagar y se retira fácilmente. Dermatológicamente probado."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
