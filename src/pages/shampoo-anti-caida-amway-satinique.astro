---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/shampoo-anti-caida-amway-satinique.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Shampoo Anti Caída Satinique - Cel: 322 346 1713",
  brand: "Shampoo Anti Caída Satinique - Productos Amway Bogota",
  servicio: "Shampoo Anti Caída Satinique",
  description: "Shampoo Anti Caída Satinique: Cuida tu cabello con esta fórmula avanzada que ayuda a fortalecerlo y reducir la caída. Su mezcla de ingredientes naturales y tecnología innovadora proporciona una nutrición completa. ¡Oferta especial por tiempo limitado! Adquiere el tuyo hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/shampoo-anti-caida-amway-satinique/",
  image: "https://productosbogota.com/shampoo-anti-caida-amway-satinique.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "52850",
  reviews: "49874",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"💆‍♂️ Shampoo Anti Caída Satinique. Un shampoo que ayuda a revitalizar y estimular el cuero cabelludo para promover el crecimiento capilar y reducir la pérdida de cabello debida al quiebre. Además contiene compuestos botánicos como ginseng, extracto de Eclipta Alba y extracto de hoja de mora.",
  caracteristica1:"Ayuda a reducir la pérdida de cabello debida al quiebre, salvando hasta 1,800 hebras de cabello al mes. Deja el cabello con más cuerpo y con un aspecto más grueso.",
  caracteristica2:"Libre de sulfatos. Ayuda a revitalizar y estimular el cuero cabelludo con el masaje para ayudar a que el cabello se vea más grueso y tenga más cuerpo. El extracto de Eclipta Alba favorece el crecimiento normal del cabello.",
  caracteristica3:"El ginseng ayuda a exfoliar el cuero cabelludo para permitir que otros tratamientos se absorban efectivamente. El extracto de hoja de mora es conocido por sus propiedades antioxidantes y por favorecer el crecimiento del cabello."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
