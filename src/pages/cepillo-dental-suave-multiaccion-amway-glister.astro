---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/cepillo-dental-suave-multiaccion-amway-glister.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Cepillo Dental Suave Multiacción Glister - Cel: 322 346 1713",
  brand: "Cepillo Dental Suave Multiacción Glister - Productos Amway Bogota",
  servicio: "Cepillo Dental Suave Multiacción Glister",
  description: "🪥 Cepillo Dental Suave Multiacción Glister: Cuida tus dientes y encías con una limpieza superior gracias a su diseño de cerdas multiacción. 🌟 ¡Oferta especial por tiempo limitado! Compra hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/cepillo-dental-suave-multiaccion-amway-glister/",
  image: "https://productosbogota.com/cepillo-dental-suave-multiaccion-amway-glister.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "52350",
  reviews:"7487",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"Esta herramienta de acción múltiple con cerdas suaves ayuda a eliminar la placa, limpiar los dientes, la lengua y masajear las encías. Una parte esencial de tu rutina diaria de cuidado bucal.",
  caracteristica1:"Con su diseño exclusivo, el Cepillo para dientes Glister facilita la eliminación efectiva de la placa en todas las superficies de los dientes cuando se utiliza con la pasta de dientes Glister, así como la limpieza a lo largo de la línea de las encías y la superficie de la lengua y las mejillas.",
  caracteristica2:"El mango flexible (área del cuello) ayuda a absorber el exceso de presión sobre las encías para una limpieza suave. El mango tiene un agarre cómodo y seguro que se ve mejorado por las nuevas superficies de TPE más blandas. Patrón de cerdas exclusivo. Las cerdas de varias alturas están configuradas para proporcionar un tratamiento interdental y remover placa efectivamente para ayudar a mantener dientes y encías saludables.",
  caracteristica3:"El limpiador de lengua/mejillas es suave pero efectivo; en la parte posterior del cabezal del cepillo proporciona una limpieza más efectiva para toda la boca y ayuda a eliminar más bacterias que el cepillado de dientes estándar solo. Los cepillos de dientes de acción múltiple Glister ahora son Sin BPA, Sin PVC y Libre de ftalatos."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
