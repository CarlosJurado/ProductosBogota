---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/crema-iluminadora-correctora-color-ideal-radiance-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Crema Iluminadora Correctora de Color Artistry Ideal Radiance - Cel: 322 346 1713",
  brand: "Crema Iluminadora Correctora de Color Artistry Ideal Radiance - Productos Amway Bogota",
  servicio: " Crema Iluminadora Correctora de Color Artistry Ideal Radiance",
  description: "Crema Iluminadora Correctora de Color Artistry Ideal Radiance: Una fórmula avanzada que ilumina y mejora la textura de la piel, proporcionando un tono más uniforme y un resplandor natural. Ideal para usar diariamente y conseguir una apariencia fresca y radiante. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/crema-iluminadora-correctora-color-ideal-radiance-amway-artistry/",
  image: "https://productosbogota.com/crema-iluminadora-correctora-color-ideal-radiance-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "218800",
  reviews:"4754",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"🌟 Crema Iluminadora Correctora de Color Artistry Ideal Radiance. Descubre el efecto de unificación de color de esta revolucionaria fórmula para que luzcas una piel de apariencia natural y luminosa. La Crema Iluminadora CC Cream con FPS 50 ilumina y protege para que luzcas una piel hermosa y siempre uniforme en un solo paso.",
  caracteristica1:"Una mezcla de perlas tahitianas que refuerza el resplandor natural de la piel. Disminuye la apariencia de las manchas oscuras e imperfecciones.",
  caracteristica2:"El FPS 50 brinda protección solar contra los dañinos rayos UV. Los pigmentos que brindan control de color unifican el tono de la piel con una cobertura de translúcida a media.",
  caracteristica3:"El Complejo Acabado Multidimensional perfecciona instantáneamente la apariencia de la piel.  Ayuda a disminuir la apariencia de manchas, líneas y otras imperfecciones."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
