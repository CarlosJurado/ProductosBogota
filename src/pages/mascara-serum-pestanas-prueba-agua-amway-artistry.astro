---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/iluminador-ojos-suero-refrescante-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Máscara + Serum de Pestañas a Prueba de Agua Artistry - Cel: 322 346 1713",
  brand: "Máscara + Serum de Pestañas a Prueba de Agua Artistry - Productos Amway Bogota",
  servicio: "Máscara + Serum de Pestañas a Prueba de Agua Artistry",
  description: "Máscara + Sérum de Pestañas a Prueba de Agua Artistry: Esta fórmula innovadora combina una máscara de alta duración y un sérum nutritivo para pestañas, que alarga y fortalece desde la raíz hasta las puntas. Resistente al agua, asegura una mirada perfecta y de impacto todo el día. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/iluminador-ojos-suero-refrescante-amway-artistry/",
  image: "https://productosbogota.com/iluminador-ojos-suero-refrescante-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "110000",
  reviews: "75876",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "👁️ Máscara + Serum de Pestañas a Prueba de Agua Artistry. Siéntete bien con una máscara de pestañas con efecto alargador y de definición hasta por 10 horas. La fórmula sin negro de carbono es a prueba de agua, grumos y manchas.",
  caracteristica1: "Con tecnología All Proof Lasting que ayuda a que los pigmentos se apliquen de manera uniforme en la superficie de las pestañas sin formar grumos, gracias a los ingredientes de larga duración a prueba de todo.",
  caracteristica2: "Con el poder del sérum: Infundido con ingredientes que ayudan a cuidar los párpados, este producto realza la forma de tus ojos mientras hace ver tus pestañas más largas.",
  caracteristica3: "El pincel en forma de media luna está diseñado para permitirte personalizar la aplicación para cualquier estilo de ojos. Levanta y riza las pestañas para obtener una apariencia general alargada."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`${pageData.servicio} de Amway tiene los mejores resultados en mi piel.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
