---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/crema-hidratante-artistry-skin-nutrition-amway.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Crema Hidratante Artistry Skin Nutrition - Cel: 322 346 1713",
  brand: "Crema Hidratante Artistry Skin Nutrition - Productos Amway Bogota",
  servicio: "Crema Hidratante Artistry Skin Nutrition",
  description: "Crema Hidratante Artistry Skin Nutrition: Diseñada para restaurar la hidratación natural de la piel, esta crema protege contra agresores externos y deja tu piel suave, luminosa y rejuvenecida. Ideal para todo tipo de piel. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/crema-hidratante-artistry-skin-nutrition-amway/",
  image: "https://productosbogota.com/crema-hidratante-artistry-skin-nutrition-amway.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "189200",
  reviews: "47605",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "💧 Crema Hidratante Artistry Skin Nutrition. Crema de Reactivación que reafirma y levanta y con el uso frecuente, tonifica visiblemente la piel alrededor del área de los ojos además ayuda a reducir la apariencia de líneas finas y signos visibles de la edad (líneas de expresión, pérdida de firmeza, resequedad, ojeras). Ofrece protección antioxidante gracias a que contiene granada cultivada de la marca Nutrilite™.",
  caracteristica1: "INGREDIENTE HÉROE - Contiene Semilla de Chía Blanca que con sus potentes fitonutrientes ayudan a nutrir y a proteger visiblemente la belleza de tu piel. Contiene nuestro Phyto-powered Prevent Complex. Una mezcla de cultivos Nutrilite, cereza acerola, margarita australiana y zarzamora, el cual refuerza el sistema de defensa natural de la piel en un 350%, ayudando a prevenir y retrasar la aparición de los primeros signos visibles del envejecimiento.",
  caracteristica2: "NATURALEZA- Agave azul, extracto de planta suculenta que ayuda a reforzar los niveles naturales de hidratación de la piel. Con granada conocida como un potente antioxidante, y permite que esta fórmula proteja contra el daño oxidativo de los radicales libres que pueden provocar un aspecto poco cuidado de la piel.",
  caracteristica3: "CIENCIA- Proteína de arroz, ayuda a prevenir los daños en el sistema de soporte de la piel y a protegerla de los signos de la edad. Dermatológicamente probado. No comedogénico. Registrado ante La Sociedad Vegana."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`${pageData.servicio} de Amway tiene los mejores resultados en mi piel.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
