---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/pasta-dientes-multiaccion-fluoruro-amway-g&h.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Pasta de Dientes Multiacción con Flúor G&H - Cel: 322 346 1713",
  brand: "Pasta de Dientes Multiacción con Flúor G&H - Productos Amway Bogota",
  servicio: "Pasta de Dientes Multiacción con Flúor G&H",
  description: "✨ Pasta de Dientes Multiacción con Flúor G&H: Cuidado completo para una sonrisa más brillante y fresca. 🌱 Protege contra caries y refuerza el esmalte dental. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/pasta-dientes-multiaccion-fluoruro-amway-g&h/",
  image: "https://productosbogota.com/pasta-dientes-multiaccion-fluoruro-amway-g&h.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "27700",
  reviews:"82158",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"✨ Pasta de Dientes Multiacción con Flúor G&H. Nueva fórmula de acción múltiple libre de parabenos y con una mezcla mejorada de sabor a menta certificada por Nutrilite™ ayuda a combatir las caries, ayuda a eliminar la placa, promueve la remineralización, ayuda a fortalecer y proteger el esmalte. Además limpia y refresca el aliento de forma segura cada vez que te cepillas los dientes. Una parte esencial de tu rutina diaria de cuidado bucal.",
  caracteristica1:"La pasta de dientes Glister ayuda a eliminar la placa, limpia eficazmente y ayuda a disminuir las manchas por consumo de café, té y tabaco. Contiene fluoruro que ayuda a fortalecer el esmalte de los dientes y a prevenir las caries.",
  caracteristica2:"Contiene nuestra exclusiva fórmula REMINACT que promueve la remineralización ayudando a depositar minerales nuevamente en el esmalte para fortalecer los dientes y hacerlos más resistentes a las caries. Apoya el equilibrio de tu microbioma oral.",
  caracteristica3:"Fórmula actualizada con Plant-Based Goodness que incluye una mezcla mejorada de sabor a menta certificada por Nutrilite. Fórmula libre de parabenos, sin alcohol, sin peróxido, sin azúcar y libre de ingredientes derivados de animales."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
