---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/hsn-colageno-hidrolizado-biotina-amway-nutrilite.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "HSN Colageno Hidrolizado con Biotina Nutrilite - Cel: 322 346 1713",
  brand: "HSN Colageno Hidrolizado Biotina Nutrilite - Productos Amway Bogota",
  servicio: "HSN Colageno Hidrolizado con Biotina Nutrilite",
  description: "💪 HSN Colágeno Hidrolizado con Biotina Nutrilite: Fortalece tu piel, cabello y uñas con esta fórmula avanzada que combina colágeno y biotina. 🌟 ¡Promoción exclusiva por tiempo limitado! Pide ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/hsn-colageno-hidrolizado-biotina-amway-nutrilite/",
  image: "https://productosbogota.com/hsn-colageno-hidrolizado-biotina-amway-nutrilite.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "79500",
  reviews:"8424",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"💪 HSN Colágeno Hidrolizado con Biotina Nutrilite. Nutrición para cabello, piel y uñas. Su fórmula contiene L-cisteína, un aminoácido que promueve la formación de queratina. Además contiene colágeno hidrolizado, biotina, extracto de semilla de uva y vitamina C que participan en la humectación de la piel. Es una combinación única de ingredientes que ayudan a nutrir el cabello, la piel y las uñas.",
  caracteristica1:"La vitamina C es antioxidante  y contribuye a la formación de colágeno para el funcionamiento normal  de la piel. Nutrilite HSN contiene 30 mg de vitamina C.",
  caracteristica2:"Con el paso del tiempo tu cuerpo disminuye la producción natural de los aminoácidos y proteínas que conforman tu cabello, piel y uñas. Incrementa la ingesta de colágeno, L-cisteína con Nutrilite HSN.",
  caracteristica3:"Belleza de adentro hacia afuera. No contiene lactosa, derivados de leche ni azúcares. Libre de colorantes y saborizantes."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
