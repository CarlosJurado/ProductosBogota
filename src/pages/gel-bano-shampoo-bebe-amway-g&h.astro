---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/gel-bano-shampoo-bebe-amway-g&h.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Gel de Baño y Shampoo para Bebé G&H - Cel: 322 346 1713",
  brand: "Gel de Baño y Shampoo para Bebé G&H - Productos Amway Bogota",
  servicio: "Gel de Baño y Shampoo para Bebé G&H",
  description: "👶 Gel de Baño y Shampoo para Bebé G&H: Limpieza suave y segura para la delicada piel y cabello de tu bebé. 🌼 Hipoalergénico y sin lágrimas, ideal para el cuidado diario. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/gel-bano-shampoo-bebe-amway-g&h/",
  image: "https://productosbogota.com/gel-bano-shampoo-bebe-amway-g&h.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "80000",
  reviews:"21853",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"👶 Gel de Baño y Shampoo para Bebé G&H. Producto 2 en 1que brinda triple barrera de protección. Ayuda a suavizar mientras limpia cuidadosamente la delicada piel del bebé, de la cabeza a los pies.",
  caracteristica1:"No deja la piel del bebé seca después del enjuague. Cada aplicación crea una espuma rica y densa que hace que el baño sea más fácil, rápido y sin lágrimas. Crea una espuma abundante directamente desde el dispensador para un baño fácil y rápido. Probado dermatológicamente, probado contra reacciones alérgicas.",
  caracteristica2:"AGUA DERIVADA DE PLANTAS: Agua de caléndula que ayuda a fortalecer la barrera de ácido hialurónico para proporcionar protección de humedad en la parte superior de la piel y proteger contra la pérdida de humedad.",
  caracteristica3:"ENRIQUECIDO CON PHYTO COMPLEX: Complejo de extracto de brotes frescos que ayuda a suavizar la delicada piel del bebé. Complejo de extracto de hoja verde que ayuda a construir una fuerte capa protectora para defender la piel del bebé de agresores externos."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
