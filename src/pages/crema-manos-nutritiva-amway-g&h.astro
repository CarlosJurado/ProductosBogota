---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/crema-manos-nutritiva-amway-g&h.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Crema para Manos Nutritiva G&H - Cel: 322 346 1713",
  brand: "Crema para Manos Nutritiva G&H - Productos Amway Bogota",
  servicio: "Crema para Manos Nutritiva G&H",
  description: "👐 Crema para Manos Nutritiva G&H: Hidratación profunda y suavidad que dura todo el día. Cuida tus manos con una fórmula enriquecida y nutritiva. 🌟 ¡Promoción exclusiva por tiempo limitado! Pide ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/crema-manos-nutritiva-amway-g&h/",
  image: "https://productosbogota.com/crema-manos-nutritiva-amway-g&h.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "54500",
  reviews:"3791",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"👐 Crema para Manos Nutritiva G&H. La crema de manos intensiva con agua de complejo de bambú, ceramida derivada del aceite de oliva, aceite de chía blanca y una alta concentración de manteca de karité nutre y alivia instantáneamente las manos secas y ásperas, proporcionando también una capa protectora de humectación en la superficie de la piel.",
  caracteristica1:"Crema no aceitosa, de rápida absorción. La fórmula con Plant-Based GoodnessT incluye fitonutrientes respaldados por la huella fitoquímica. Con ceramidas derivadas del aceite de oliva que ayuda a mantener la barrera de humedad de la piel. Probado dermatológicamente. ",
  caracteristica2:"Aumento instantáneo/inmediato del 127% en la hidratación de la piel. Con agua bambú y glicerina de origen vegetal que ayuda a hidratar la piel. No probado en animales. Adecuado para todo tipo de piel. Probado contra reacciones alérgicas.",
  caracteristica3:"Fragancia de larga duración con notas de té verde, durazno, manzanilla y mandarina. Intensificado con aceite de chía blanca uno de los superalimentos más ricos de la naturaleza, sus fitonutrientes intensifican y protegen visiblemente la belleza de la piel."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
