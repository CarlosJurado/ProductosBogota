---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/vitamina-d-tabletas-amway-nutrilite.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Vitamina D Tabletas Nutrilite - Cel: 322 346 1713",
  brand: "Vitamina D Tabletas Nutrilite - Productos Amway Bogota",
  servicio: "Vitamina D Tabletas Nutrilite",
  description: "☀️ Vitamina D Tabletas Nutrilite: Apoya tu salud ósea y fortalece tu sistema inmunológico con este suplemento de vitamina D de fácil absorción. Ideal para mantenerte saludable durante todo el año. 🌟 ¡Oferta especial por tiempo limitado! Adquiere el tuyo hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/vitamina-d-tabletas-amway-nutrilite/",
  image: "https://productosbogota.com/vitamina-d-tabletas-amway-nutrilite.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "118200",
  reviews: "71927",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"☀️ Vitamina D Tabletas Nutrilite. 1 tableta de vitamina D proporciona 1000 UI necesarias para el buen desempeño del organismo. Además contiene champiñones que es una fuente botánica rica en vitamina D.",
  caracteristica1:"Potenciada por una de las fuentes botánicas de la vitamina esencial más concentrada de la naturaleza: los champiñones. Con origen en nuestras granjas asociadas de Nutrilite™, cada tableta brinda la vitamina D equivalente a 16 tazas de leche fortificada para ayudar a apoyar la salud ósea y el sistema inmunológico.",
  caracteristica2:"La Vitamina D Nutrilite™ le brinda a tus huesos y articulaciones (y a todo lo demás) una dosis suplementaria de 2,000 UI de vitamina D de plantas, incluidos champiñones (una de las fuentes botánicas de vitamina D más concentradas de la naturaleza).",
  caracteristica3:"Cada tableta brinda la vitamina D equivalente a 16 tazas de leche fortificada para ayudar a apoyar la salud ósea y el sistema inmunológico."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
