---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/phytopowder-sabor-naranja-amway-nutrilite.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Phytopowder Sabor Naranja Nutrilite - Cel: 322 346 1713",
  brand: "Phytopowder Sabor Naranja Nutrilite - Productos Amway Bogota",
  servicio: "Phytopowder Sabor Naranja",
  description: "🍊 Phytopowder Sabor Naranja Nutrilite: Disfruta de un delicioso sabor a naranja mientras obtienes antioxidantes y fitonutrientes esenciales para mantener tu salud y energía. Fácil de preparar y perfecto para tu rutina diaria. 🌟 ¡Promoción exclusiva por tiempo limitado! Pide ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/phytopowder-sabor-naranja-amway-nutrilite/",
  image: "https://productosbogota.com/phytopowder-sabor-naranja-amway-nutrilite.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "165200",
  reviews: "4915",
  cliente1: "Darwin Ramirez",
  cliente2: "Francisco Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "🍊 Phytopowder Sabor Naranja Nutrilite. Hidrátate con una deliciosa bebida baja en calorías sabor naranja. Es una mezcla en polvo para preparar una bebida con electrolitos, vitaminas y fitonutrientes, diseñada para ser añadida al agua.",
  caracteristica1: "Cada bebida ofrece 50 mg de Red Orange Complex, desarrollado utilizando las naranjas rojas cultivadas exclusivamente en la región fértil del Monte Etna en Sicilia.",
  caracteristica2: "Contiene potasio, cloruro y sodio, importantes electrolitos que facilitan la absorción de líquidos y contribuyen a una hidratación más completa.",
  caracteristica3: "Con el exclusivo extracto de jugo de naranja roja, rico en fitonutrientes y antioxidantes que combaten el estrés oxidativo durante la actividad física."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />

  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
  servicio={pageData.servicio}
  cliente1={pageData.cliente1}
  cliente2={pageData.cliente2}
  cliente3={pageData.cliente3}
  servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
  servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
  servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
/>

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
