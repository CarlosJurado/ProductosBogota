---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/acondicionador-cuidado-color-amway-satinique.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Acondicionador Cuidado Color Satinique | Cel: 322 346 1713",
  brand: "Acondicionador Cuidado Color Satinique - Productos Amway Bogota",
  servicio: "Acondicionador Cuidado Color Satinique",
  description: "Acondicionador Cuidado Color Satinique: Protege y realza el brillo de tu cabello teñido. ¡Promoción exclusiva por tiempo limitado! Pide ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/acondicionador-cuidado-color-amway-satinique/",
  image: "https://productosbogota.com/acondicionador-cuidado-color-amway-satinique.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "52850",
  reviews:"980",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"💆‍♀️ Acondicionador Cuidado Color Satinique. Este sistema de shampoo y acondicionador ofrece una limpieza delicada y un acondicionamiento suave para proteger, fortalecer y reparar el cabello, mientras ayuda a mantener el color e intensificar el brillo. Ayuda a reparar el cabello y a prevenir las puntas abiertas.",
  caracteristica1:"Cuenta con el exclusivo Complejo Enerjuve que ayuda a restaurar el estado natural del cabello y su apariencia saludable. Mantiene el color original por más tiempo.",  
  caracteristica2:"Reduce la decoloración, ayudando a mantener el color hasta 45 lavadas. El cabello maltratado se revitaliza y el color se mantiene por más tiempo, ya que este shampoo fue diseñado para el cabello dañado o teñido.",
  caracteristica3:"Contiene compuestos botánicos como extracto de granada y extracto de semilla de uva. El extracto de granada ayuda a revitalizar el cabello opaco y reseco.El extracto de semilla de uva ayuda a proteger el cabello contra daños causados por el ambiente."
};




const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
