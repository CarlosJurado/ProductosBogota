---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/suero-diario-vitamina-c-ha3-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Suero Diario de Vitamina C + HA3 Artistry - Cel: 322 346 1713",
  brand: "Suero Diario de Vitamina C + HA3 Artistry - Productos Amway Bogota",
  servicio: "Suero Diario de Vitamina C + HA3 Artistry",
  description: "🍊 Suero Diario de Vitamina C + HA3 Artistry: Combina el poder de la vitamina C y HA3 para iluminar tu piel, mejorar su textura y brindar una hidratación profunda. Logra una piel más radiante y rejuvenecida con el uso diario. 🌟 ¡Promoción exclusiva por tiempo limitado! Compra ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/suero-diario-vitamina-c-ha3-amway-artistry/",
  image: "https://productosbogota.com/suero-diario-vitamina-c-ha3-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "254400",
  reviews: "54847",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"🍊 Suero Diario de Vitamina C + HA3 Artistry. El Suero Diario de Vitamina C+HA3 ayuda a reducir visiblemente las líneas de la edad, revelando una piel más radiante e iluminada. Su fórmula con Vitamina C 100% pura contiene fitonutrientes que aumentan la luminosidad de la piel, ayudando a que se sienta más firme y renovada. La fusión triple de ácido hialurónico funciona instantáneamente mejorando la apariencia tersa de la piel gracias a sus propiedades antioxidantes.",
  caracteristica1:"Contiene Semilla de Chía Blanca que con sus potentes fitonutrientes ayudan a nutrir y proteger visiblemente la belleza de tu piel.",
  caracteristica2:"La Vitamina C ayuda a reparar la piel brindando protección antioxidante aportando luminosidad revelando un tono visualmente más uniforme.",
  caracteristica3:"En las pruebas a consumidores, el 89%* de mujeres están de acuerdo que el Suero Diario de Vitamina C + HA3 hace que la piel luzca más brillante e hidratada."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
