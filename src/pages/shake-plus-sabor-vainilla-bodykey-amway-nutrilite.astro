---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/shake-plus-sabor-vainilla-bodykey-amway-nutrilite.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Shake Plus Sabor Vainilla Bodykey Nutrilite - Cel: 322 346 1713",
  brand: "Shake Plus Sabor Vainilla Bodykey Nutrilite - Productos Amway Bogota",
  servicio: "Shake Plus Sabor Vainilla Bodykey Nutrilite",
  description: "🥤 Shake Plus Sabor Vainilla Bodykey Nutrilite: Un batido sabroso y saludable para apoyar tu plan de control de peso. Disfruta de un sabor irresistible y nutrientes clave para tu energía. 🌟 ¡Oferta especial por tiempo limitado! Compra hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/shake-plus-sabor-vainilla-bodykey-amway-nutrilite/",
  image: "https://productosbogota.com/shake-plus-sabor-vainilla-bodykey-amway-nutrilite.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "167650",
  reviews: "51874",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"🥤 Shake Plus Sabor Vainilla Bodykey Nutrilite. Nuestra fórmula exclusiva fue desarrollada bajo la filosofía BodyKey by Nutrilite™, dando como resultado un delicioso y nutritivo polvo sabor a chocolate para crear una bebida nutricional al mezclar con agua o con leche baja en grasa, que proporciona proteína, fibra, vitaminas y minerales.",
  caracteristica1:"Su fórmula aporta 12 vitaminas y 13 minerales a tu organismo, con 12 gramos de proteína vegetal, (ideal para complemetar la alimentación.",
  caracteristica2:"Contiene ingredientes que aportan fibra y carbohidratos simples y complejos, con grasas esenciales, lo que lo hace una bebida que complementa tu alimentación.",
  caracteristica3:"Cuenta con ingredientes de origen natural. No contiene cafeína, y es libre de colorantes, saborizantes ni preservantes artificiales."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
