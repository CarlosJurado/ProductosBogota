---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/gel-bano-exfoliante-refrescante-amway-g&h.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);


const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Gel de Baño Exfoliante Refrescante G&H - Cel: 322 346 1713",
  brand: "Gel de Baño Exfoliante Refrescante G&H - Productos Amway Bogota",
  servicio: "Gel de Baño Exfoliante Refrescante G&H",
  description: "🛁 Gel de Baño Exfoliante Refrescante G&H: Dale a tu piel un cuidado excepcional con exfoliación suave y frescura prolongada. 🌟 Ideal para lucir una piel radiante todos los días. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/gel-bano-exfoliante-refrescante-amway-g&h/",
  image: "https://productosbogota.com/gel-bano-exfoliante-refrescante-amway-g&h.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "59950",
  reviews:"29185",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"🛁 Gel de Baño Exfoliante Refrescante G&H. El gel de baño exfoliante diario con agua de complejo de bambú, ceramida derivada del aceite de oliva, acerola verde y exfoliantes naturales, ayuda a eliminar suavemente las impurezas y las células muertas de la piel, dejándola con una sensación de frescura e hidratación. Fórmula biodegradable.",
  caracteristica1:"Contiene granos de jojoba y exfoliantes naturales de cáscaras de nueces trituradas, carozo de damasco y almendras para eliminar instantáneamente las células muertas, ayudando a darle a la piel un tono más brillante y uniforme.",
  caracteristica2:"Para hombres y mujeres. Adecuado para todo tipo de piel (normal, grasa, seca y mixta). No probado en animales. No contiene ingredientes de origen animal. Aroma botánico con notas de fragancia de cítricos, naranja y lavanda.",
  caracteristica3:"Con ceramida derivada del aceite de oliva, su fórmula ayuda a mantener la barrera de hidratación de la piel. Frasco fabricado con un 30% de material reciclado. Probado dermatológicamente. Probado contra reacciones alérgicas."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
