---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/te-bodykey-herbal-mix-amway-nutrilite.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Té Bodykey Herbal Mix Nutrilite - Cel: 322 346 1713",
  brand: "Té Bodykey Herbal Mix Nutrilite - Productos Amway Bogota",
  servicio: "Té Bodykey Herbal Mix Nutrilite",
  description: "Té Bodykey Herbal Mix Nutrilite: Disfruta de la mezcla perfecta de hierbas para apoyar tus objetivos de bienestar y control de peso. Con ingredientes como té verde, este té no solo es delicioso, sino que también favorece el metabolismo de forma natural. ¡Oferta especial por tiempo limitado! Adquiere el tuyo hoy. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/te-bodykey-herbal-mix-amway-nutrilite/",
  image: "https://productosbogota.com/te-bodykey-herbal-mix-amway-nutrilite.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "101100",
  reviews: "61437",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"🍵 Té Bodykey Herbal Mix Nutrilite. Herbal Mix contiene una mezcla de Té negro y Té verde. Su exclusiva fórmula contiene vitaminas del complejo B y vitamina C, además contiene guaraná, jengibre y canela. Delicioso sabor a limón y endulzado con Stevia.",
  caracteristica1:"Aporta los beneficios de las vitaminas B1, B2, B6 y la C, elaborado con ingredientes de origen natural: hojas y tallos de té negro y té verde con polvo y semillas de guaraná, canela y jengibre en polvo con aroma natural de limón.",
  caracteristica2:"Polvo de té negro y té verde & Semillas de guaraná: ricos en antioxidantes, té estimulante por su contenido de cafeína. ",
  caracteristica3:"Polvo de jengibre: le da un delicioso sabor (contenido 3%, como saborizante). Canela en polvo: rica en antioxidantes, le da un delicioso sabor (contenido 3%, como saborizante)."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
