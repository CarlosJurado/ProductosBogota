---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/tonico-hidratante-suavizante-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Tónico Hidratante y Suavizante Artistry Skin - Cel: 322 346 1713",
  brand: "Tónico Hidratante y Suavizante Artistry Skin - Productos Amway Bogota",
  servicio: "Tónico Hidratante y Suavizante Artistry Skin",
  description: "💧 Tónico Hidratante y Suavizante Artistry Skin: Formulado con ingredientes premium, equilibra el pH de tu piel, reduce la apariencia de poros y la deja sedosa al tacto. Ideal para todo tipo de piel. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/tonico-hidratante-suavizante-amway-artistry/",
  image: "https://productosbogota.com/tonico-hidratante-suavizante-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "97000",
  reviews: "6904",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "💧 Tónico Hidratante y Suavizante Artistry Skin. Tónico que ayuda a eliminar las impurezas y cualquier residuo que el limpiador haya dejado, refrescando la piel y dejándola más preparada y receptiva para recibir los cuidados posteriores.",
  caracteristica1: "INGREDIENTE HEROE- Contiene Semilla de Chía Blanca que con sus potentes fitonutrientes ayudan a nutrir y proteger visiblemente la belleza de tu piel. NATURALEZA- Regaliz, extracto de raíz utilizado para relajar la piel.",
  caracteristica2: "Liposoma de Chía Blanca retiene la humedad, ayuda a sellar la propia humedad de la piel y a prevenir la pérdida de la misma. El tónico ayuda a controlar el microbioma de su piel, ayuda previniendo que se salga de control.",
  caracteristica3: "CIENCIA- Prebióticos, extracto de gel de chía blanca que equilibra el microbioma y ayuda a la función de la barrera de humectación de la piel."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`${pageData.servicio} de Amway tiene los mejores resultados en mi piel.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
