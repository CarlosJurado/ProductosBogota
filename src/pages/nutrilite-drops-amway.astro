---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/nutrilite-drops-amway.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Nutrilite Drops Amway - Cel: 322 346 1713",
  brand: "Nutrilite Drops - Productos Amway Bogota",
  servicio: "Nutrilite Drops",
  description: "Nutrilite Drops: Fórmula concentrada de vitaminas y minerales en gotas para una absorción rápida y efectiva. Ideal para apoyar tu salud y energía. ¡Oferta especial por tiempo limitado! Compra hoy. 📞 322 346 1713 - Productos Amway Bogotá.💧 Nutrilite Drops: Suplemento líquido de alta calidad que proporciona vitaminas y nutrientes esenciales para mantenerte activo y saludable. Perfecto para tu bienestar diario. 🌟 ¡Promoción exclusiva por tiempo limitado! Pide ahora. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/nutrilite-drops-amway/",
  image: "https://productosbogota.com/nutrilite-drops-amway.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "33300",
  reviews: "5819",
  cliente1: "Darwin Ramirez",
  cliente2: "Francisco Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "💧 Nutrilite DROPS es un líquido concentrado en una práctica presentación. Solo ábrelo y agrega un chorrito (aprox 2mL) al agua para disfrutar de un delicioso sabor de frutos mixtos y los beneficios de la vitamina C.",
  caracteristica1: "Solo 8 calorías por porción. Cada porción te aporta 60 mg de vitamina C, como antioxidante.",
  caracteristica2: "Contiene saborizantes naturales como mango, limón y fresa. Zanahoria y arándanos le dan su color característico.",
  caracteristica3: "No contiene azúcar, endulzado con stevia. Libre de colorantes, saborizantes y preservantes artificiales."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
