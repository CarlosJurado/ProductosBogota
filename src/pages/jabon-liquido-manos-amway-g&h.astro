---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/jabon-liquido-manos-amway-g&h.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename:"Productos Amway Bogota",
  title: "Jabón Líquido para Manos G&H - Cel: 322 346 1713",
  brand: "Jabón Líquido para Manos G&H - Productos Amway Bogota",
  servicio: "Jabón Líquido para Manos G&H",
  description: "🧼 Jabón Líquido para Manos G&H: Limpia y humecta tus manos con una fórmula suave y nutritiva. 🌿 Ideal para toda la familia. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/jabon-liquido-manos-amway-g&h/",
  image: "https://productosbogota.com/jabon-liquido-manos-amway-g&h.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "54500",
  reviews:"23110",
  cliente1:"Dayana Ramirez",
  cliente2:"Karen Martinez",
  cliente3:"Andrea Casallas",
  descripcion:"🧼 Jabón Líquido para Manos G&H. El jabón antibacterial de manos, que no reseca, está formulado con agua de palmera de cica, romero y té verde, efectivo contra los gérmenes más comunes, manteniendo las manos limpias y frescas. Fórmula con biodegradabilidad demostrada.",
  caracteristica1:"Fórmula sin triclosán que ayuda a eliminar de manera efectiva las bacterias comunes, la suciedad, la oleosidad y las impurezas. Deja tus manos limpias, frescas e hidratadas, con una apariencia bien cuidada. Fórmula biodegradable y vegana registrada en la Sociedad Vegana. Probado dermatológicamente. Probado contra reacciones alérgicas. Frasco producido con un 30% de material reciclado.",
  caracteristica2:"INGREDIENTES DERIVADOS DE PLANTAS: Extracto de té verde que ofrece protección antioxidante y extracto de romero que ayuda a relajar la piel. Su fórmula no reseca y ayuda a mantener la barrera de humedad natural de la piel y el equilibrio de su hidratación. Fragancia exclusiva con tecnología que ayuda a neutralizar los olores.",
  caracteristica3:"INGREDIENTES PLANT-BASED GOODNESST La fórmula con Plant-Based GoodnessT incluye fitonutrientes respaldados por la huella fitoquímica."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody:
      `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename, },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
title={pageData.title}
description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  
  <Navigation servicio={pageData.title} links={navigationLinks} />

  <Cta
  pagina={pageData.sitename}
  servicio={pageData.servicio}
  imagen={imagen}
  />
  
  <Hero
  servicio={pageData.servicio}
  descripcion={pageData.descripcion}
  caracteristica1={pageData.caracteristica1}
  caracteristica2={pageData.caracteristica2}
  caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2/>
  <SectionOne />

  <Boton1/>

  <Testimonial
  servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, muy buena calidad.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />


  <Boton servicio={pageData.servicio}/>

  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
    

</BaseLayout>
