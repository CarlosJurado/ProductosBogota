---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/lapiz-gel-cejas-prueba-agua-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Lipstick Acabado en Crema Artistry - Cel: 322 346 1713",
  brand: "Lipstick Acabado en Crema Artistry - Productos Amway Bogota",
  servicio: "Lipstick Acabado en Crema Artistry",
  description: "Lipstick Acabado en Crema Artistry: Un labial que combina un color rico y duradero con una fórmula hidratante que cuida tus labios. Ideal para un look natural o un toque de glamour. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/lapiz-gel-cejas-prueba-agua-amway-artistry/",
  image: "https://productosbogota.com/lapiz-gel-cejas-prueba-agua-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "85000",
  reviews: "75874",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "💋 Lipstick Acabado en Crema Artistry. ¡Vibra y llenate de confianza con Vibrant Lipstick de Artistry!",
  caracteristica1: "Esta innovadora fórmula brinda un color de alto impacto en un solo trazo. El secreto: un aumento* de pigmento del + 190% que crea unos labios vibrantes e impermeables. Dramático y audaz. Obtén confianza para expresar tu belleza. La fórmula seleccionada  incluye una mezcla cuidadosamente ingredientes derivados de plantas que ayudan a regenerar la piel de los labios, mientras dejan que el color brilla de manera vibrante. ",
  caracteristica2: "La fórmula súper cremosa e hidratante deja los labios con un aspecto vibrante, lleno de color, y con una cómoda sensación de suavidad e hidratación. Acabado satinado. Evita que se difumine y se corra. Con ingredientes que cuidan la piel, ofrece lo mejor de la ciencia, de la naturaleza y el color, con su infusión de dispersiones de pigmentos líquidos con aceites botánicos. ",
  caracteristica3: "La gama de colores de los Lipsticks Artistry Go Vibrant, acabado en crema o matte, han sido probamos la gama de colores en una amplia diversidad de tonos de piel, para crear una línea favorecedora y universal. ¡No te puedes equivocar! Fórmula vegana cumple con los estándares Artistry Clean Beauty, un También son libres de fragancias. No contienen ingredientes de origen animal y están registrados en la Vegan Society. Sin experimentación en animales."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`${pageData.servicio} de Amway tiene los mejores resultados en mi piel.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
