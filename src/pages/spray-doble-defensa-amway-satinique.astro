---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/spray-doble-defensa-amway-satinique.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Spray de Defensa Doble Satinique - Cel: 322 346 1713",
  brand: "Spray de Defensa Doble Satinique - Productos Amway Bogota",
  servicio: "Spray de Defensa Doble Satinique",
  description: "🌟 Spray de Defensa Doble: Cuida tu cabello con esta fórmula única que ofrece protección contra factores ambientales y mejora la resistencia de tu cabello. Perfecto para mantener tu cabello radiante y protegido. 📞 Contáctanos: 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/spray-doble-defensa-amway-satinique/",
  image: "https://productosbogota.com/spray-doble-defensa-amway-satinique.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "83250",
  reviews: "71547",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion:"🌟 Spray de Defensa Doble. Rociador translúcido que protege tu cabello del daño térmico y los rayos UV, dejándolo más hidratado, sedoso y brillante. Siente tu cabello nueve veces más fuerte. ",
  caracteristica1:"Promueve la restauración de las defensas naturales del cabello contra los daños ambientales. Ayuda a prevenir la resequedad y fragilidad del cabello añadiendo brillo y humectación. Para todo tipo de cabello, especialmente para cabello teñido que tiende a decolorarse.",
  caracteristica2:"Protege el cabello contra los efectos nocivos de la luz UV y otros daños causados durante el estilizado con calor. Mezcla de vitamina E, extracto de granada y extracto de semilla de uva. El extracto de granada ayuda a revitalizar el cabello opaco y reseco.",
  caracteristica3:"El extracto de semilla de uva ayuda a proteger el cabello contra daños por el ambiente. La vitamina E ayuda a mantener la humectación en el cabello."
};


const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente2,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-07-01",
    author: { "@type": "Person", name: pageData.cliente2 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 1200,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />

  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />

  <Hero
    titulo={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />


  <Boton2 />
  <SectionOne />

  <Boton1 />

  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`}
    servicio2={`Mi ${pageData.servicio} de Amway tiene los mejores ingredientes.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />

  <Boton servicio={pageData.servicio} />

  <WhatsApp url={pageData.link} />

  <Footer serviciof={pageData.servicio} links={footerLinks} />
</BaseLayout>
