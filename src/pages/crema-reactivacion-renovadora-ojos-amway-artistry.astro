---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/global/Navigation.astro";
import WhatsApp from "../components/global/Whatsapp.astro";

import Cta from "../components/servicio/Cta.astro";
import Hero from "../components/servicio/Hero.astro";
import SectionOne from "../components/landing/SectionOne.astro";
import Testimonial from "../components/global/Testimonial.astro";
import Boton from "../components/global/Boton.astro";
import Boton1 from "../components/global/Boton1.astro";
import Boton2 from "../components/global/Boton2.astro";
import Footer from "../components/global/Footer.astro";
import { AstroSeo } from "@astrolib/seo";
import Seo from "../components/Seo.astro";
import imagen from "../../public/crema-reactivacion-renovadora-ojos-amway-artistry.jpg";

import { getLinksForPage } from '../components/data/distributeLinks';
const currentPageUrl = Astro.url.pathname;
const { navigationLinks, footerLinks } = getLinksForPage(currentPageUrl);

const pageData = {
  sitename: "Productos Amway Bogota",
  title: "Crema de Reactivación Renovadora para Ojos Artistry - Cel: 322 346 1713",
  brand: "Crema de Reactivación Renovadora para Ojos Artistry - Productos Amway Bogota",
  servicio: "Crema de Reactivación Renovadora para Ojos Artistry",
  description: "Crema de Reactivación Renovadora para Ojos Artistry:  Especialmente formulada para reducir líneas de expresión, ojeras y signos de fatiga. Hidrata profundamente y aporta una apariencia más fresca y juvenil a tu mirada. 📞 322 346 1713 - Productos Amway Bogotá.",
  canonical: "https://productosbogota.com/crema-reactivacion-renovadora-ojos-amway-artistry/",
  image: "https://productosbogota.com/crema-reactivacion-renovadora-ojos-amway-artistry.jpg",
  link: "https://linkeo.click/ProductosAmwayBogota",
  price: "210200",
  reviews: "37060",
  cliente1: "Dayana Gomez",
  cliente2: "Francisca Martinez",
  cliente3: "Andrea Casallas",
  descripcion: "👁️ Crema de Reactivación Renovadora para Ojos Artistry. Crema de Reactivación que reafirma y levanta y con el uso frecuente, tonifica visiblemente la piel alrededor del área de los ojos además ayuda a reducir la apariencia de líneas finas y signos visibles de la edad (líneas de expresión, pérdida de firmeza, resequedad, ojeras). Ofrece protección antioxidante gracias a que contiene granada cultivada de la marca Nutrilite™.",
  caracteristica1: "INGREDIENTE HÉROE - Contiene Semilla de Chía Blanca que con sus potentes fitonutrientes ayudan a nutrir y a proteger visiblemente la belleza de tu piel. Contiene nuestro Phyto-powered Repair Complex. Una mezcla de cultivos NutriliteT; espinaca, cúrcuma y té de flor de olivo, la cual ayuda a revertir los signos visibles de la edad y a reparar la elasticidad y firmeza de la piel en un 600%.",
  caracteristica2: "NATURALEZA - Contiene Extracto de Avena de origen natural que ayuda a reafirmar la delicada zona alrededor de los ojos. ",
  caracteristica3: "CIENCIA - Contiene péptidos, la mezcla de péptidos ayuda a reducir la retención de líquidos que se forman debajo de los ojos. Dermatológicamente probado. No comedogénico. Registrado ante La Sociedad Vegana."
};

const schema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  name: pageData.title,
  image: pageData.image,
  description: pageData.description,
  brand: {
    "@type": "Brand",
    name: pageData.brand,
  },
  offers: {
    "@type": "Offer",
    url: pageData.canonical,
    priceCurrency: "COP",
    price: pageData.price,
    priceValidUntil: "2025-02-28",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "5",
    ratingCount: pageData.reviews,
    reviewCount: pageData.reviews,
  },
  review: {
    "@type": "Review",
    name: pageData.cliente1,
    reviewBody: `Muy buen producto, la calidad de ${pageData.servicio} de Amway es la mejor.`,
    reviewRating: {
      "@type": "Rating",
      ratingValue: "5",
      bestRating: "5",
      worstRating: "5",
    },
    datePublished: "2024-06-01",
    author: { "@type": "Person", name: pageData.cliente1 },
    publisher: { "@type": "Organization", name: pageData.sitename },
  },
};
---

<Seo schemaMarkup={schema} />
<AstroSeo
  title={pageData.title}
  description={pageData.description}
  canonical={pageData.canonical}
  openGraph={{
    url: pageData.canonical,
    title: pageData.title,
    description: pageData.description,
    images: [
      {
        url: pageData.image,
        width: 1200,
        height: 675,
        alt: pageData.title,
        type: "image/jpeg",
      },
    ],
    site_name: pageData.sitename,
  }}
/>
<BaseLayout>
  <Navigation servicio={pageData.servicio} links={navigationLinks} />
  
  <Cta
    pagina={pageData.sitename}
    servicio={pageData.servicio}
    imagen={imagen}
  />
  
  <Hero
    servicio={pageData.servicio}
    descripcion={pageData.descripcion}
    caracteristica1={pageData.caracteristica1}
    caracteristica2={pageData.caracteristica2}
    caracteristica3={pageData.caracteristica3}
  />
  
  <Boton2 />
  <SectionOne />
  
  <Boton1 />
  
  <Testimonial
    servicio={pageData.servicio}
    cliente1={pageData.cliente1}
    cliente2={pageData.cliente2}
    cliente3={pageData.cliente3}
    servicio1={`Recomiendo ${pageData.servicio} de Amway, es excelente y de muy buena calidad.`}
    servicio2={`${pageData.servicio} de Amway tiene los mejores resultados en mi piel.`}
    servicio3={`Llevo años con ${pageData.servicio} de Amway y estoy muy feliz con los resultados.`}
  />
  
  <Boton servicio={pageData.servicio} />
  
  <WhatsApp url={pageData.link} />
  
  <Footer serviciof={pageData.title} links={footerLinks} />
</BaseLayout>
